@echo off
rem Builds GlassBreaker.exe with the C# compiler that ships with Windows (.NET Framework 4.x).
rem The icon in assets\app.ico is generated by the app itself: GlassBreaker.exe --icon
setlocal
set CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe
if not exist "%CSC%" set CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe
"%CSC%" /nologo /target:winexe /optimize+ /out:"%~dp0GlassBreaker.exe" /win32icon:"%~dp0assets\app.ico" /r:System.Windows.Forms.dll /r:System.Drawing.dll "%~dp0src\*.cs"
